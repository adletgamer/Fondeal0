# ---- Stellar / Soroban (Testnet) ----
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
# SEP-10 / networking
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# USDC on Testnet — Stellar Asset Contract (SAC) address; set after wiring the asset.
NEXT_PUBLIC_USDC_ASSET_CODE=USDC
NEXT_PUBLIC_USDC_ISSUER=
NEXT_PUBLIC_USDC_SAC_ADDRESS=

# Deployed contract IDs (filled by scripts/deploy after Phase 4/5/6)
NEXT_PUBLIC_PASSPORT_CONTRACT_ID=
NEXT_PUBLIC_SCORE_CONTRACT_ID=
NEXT_PUBLIC_ESCROW_CONTRACT_ID=

# ---- Deployer (Testnet only — funds gas/fees for contract deploys) ----
# A pre-generated Testnet account (worthless funds). Fund it via Friendbot:
#   https://friendbot.stellar.org/?addr=GBKBOFI3JZ7DI552VPHZAGN7GCGFF4DPOCAZEZ5LTROTRQ6F6RPO66ZL
# The deploy script reads DEPLOYER_SECRET; put the real secret ONLY in a local
# (gitignored) .env, never here. Or omit it and the script generates + funds one.
DEPLOYER_PUBLIC=GBKBOFI3JZ7DI552VPHZAGN7GCGFF4DPOCAZEZ5LTROTRQ6F6RPO66ZL
DEPLOYER_SECRET=

# ---- Backend ----
DATABASE_URL=postgresql://fondealo:fondealo@localhost:5432/fondealo?schema=public
# SEP-10 server signing key (server-side only; never expose)
SEP10_SERVER_SECRET=
# JWT signing secret for SEP-10 sessions
AUTH_JWT_SECRET=
