# ---- Stellar / Soroban (Testnet) ----
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
# SEP-10 / networking
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# The asset the escrow holds. On Testnet the deploy script issues its own test
# asset (FTUSD) and prints its Stellar Asset Contract address. To escrow Circle's
# Testnet USDC instead, export TOKEN_SAC_ADDRESS (or USDC_SAC_ADDRESS) before
# deploying. Copy the value from deployments/testnet.json.
NEXT_PUBLIC_USDC_ASSET_CODE=FTUSD
NEXT_PUBLIC_USDC_ISSUER=
NEXT_PUBLIC_USDC_SAC_ADDRESS=

# Deployed contract ids: copy from deployments/testnet.json after
# scripts/deploy_testnet.sh (or the "Deploy contracts to Testnet" workflow).
NEXT_PUBLIC_PASSPORT_CONTRACT_ID=
NEXT_PUBLIC_SCORE_CONTRACT_ID=
NEXT_PUBLIC_ESCROW_CONTRACT_ID=

# ---- Contract roles (Testnet only; read by scripts/deploy_testnet.sh) ----
# Three different accounts. The script imports them into the stellar-cli
# keystore as fondealo-admin / fondealo-issuer / fondealo-keeper, or generates
# them locally with GENERATE_KEYS=1. Put secrets ONLY in the gitignored root
# .env or in the GitHub environment `testnet`, never here, and never a Mainnet key.
ADMIN_SECRET_KEY=
ISSUER_SECRET_KEY=
KEEPER_SECRET_KEY=

# ---- Backend ----
# Neon Postgres. Runtime uses the pooled host; Prisma Migrate uses the direct one.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require
# Neon Auth / Data API — public JWKS used to verify Neon-issued JWTs (not a secret).
NEON_AUTH_JWKS_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth/.well-known/jwks.json
# SEP-10 server signing key (server-side only; never expose)
SEP10_SERVER_SECRET=
# JWT signing secret for SEP-10 sessions
AUTH_JWT_SECRET=

# ---- Auth + wallet (Privy) ----
# Create an app at https://dashboard.privy.io — Stellar has Tier 2 support
# (wallet creation + raw-hash signing) via @privy-io/react-auth/extended-chains.
# /invest and /business are gated behind login; on first login we create a
# real Stellar embedded wallet (a real G... keypair, not a simulation) via
# Privy and use its address as the connected identity everywhere.
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-side only — verifies Privy auth tokens. Never expose with NEXT_PUBLIC_.
PRIVY_APP_SECRET=

# ---- Product flags (optional) ----
# New Investor sign-ups are off by default: Fondealo does not run a public
# investment marketplace. Set to "true" only for an isolated Testnet demo.
NEXT_PUBLIC_INVESTOR_SIGNUP=
# Shown on the application-status screen as a human contact when set.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Server-only secret for HMAC-ing waitlist IPs (rate limiting). Unset = no IP
# data stored and no rate limit. Use a long random value per environment.
WAITLIST_IP_SECRET=
