// Fondealo off-chain index + PII store.
//
// On-chain (Soroban) remains authoritative for anything trust-bearing
// (Passport, score). This database is a fast, queryable PROJECTION of on-chain
// state plus off-chain data that must never live on-chain (KYB PII, opportunity
// descriptions, UX metadata). Only `data_hash` commitments bridge the two.

generator client {
  provider      = "prisma-client-js"
  // Vercel runs on Amazon Linux (rhel-openssl-3.0.x); local dev is Windows/macOS.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled connection (pgbouncer) doesn't support the session-level
  // features Prisma Migrate needs; directUrl gives migrations a direct
  // connection while runtime queries keep using the pooled one.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum KybStatus {
  None
  Processing
  Accepted
  Rejected
}

enum RiskBand {
  A
  B
  C
  D
  E
}

enum OpportunityStatus {
  Draft
  Open
  Funded
  Active
  Repaid
  Defaulted
  Cancelled
}

/// A wallet's chosen side of the marketplace. Set once during onboarding
/// (docs/product-v2.md role-selection flow) and enforced server-side —
/// a Business wallet can never load /invest and vice versa.
enum UserRole {
  Business
  Investor
}

/// A registered business. `stellarAddress` is the on-chain identity key.
model Business {
  id              String   @id @default(cuid())
  stellarAddress  String   @unique
  legalName       String
  country         String
  email           String?
  /// KYB profile captured at registration (docs/strategy/verifier-network.md).
  sector          String?
  taxId           String?
  foundedYear     Int?
  revenueBand     String?
  /// Off-chain look of the Passport (identity layer only — never credit data).
  passportTheme   String?
  passportAccent  String?
  passportPattern String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  kybSubmissions KybSubmission[]
  opportunities  Opportunity[]
  passport       PassportProjection?

  @@unique([country, taxId])
  @@index([country])
}

/// A logged-in wallet. Identity is anchored to `privyUserId` (verified
/// server-side from the Privy session on every request — never trusted from
/// a client-supplied address); `stellarAddress` is the embedded Stellar
/// wallet Privy creates on first login. `role` is null until onboarding's
/// role-selection step persists it.
model UserWallet {
  id             String    @id @default(cuid())
  privyUserId    String?   @unique
  stellarAddress String    @unique
  role           UserRole?
  createdAt      DateTime  @default(now())
  lastLoginAt    DateTime?
}

/// KYB intake, shaped after SEP-12. `fields` holds provider-specific data (PII).
model KybSubmission {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id])
  status      KybStatus @default(Processing)
  /// Which verifier issued the decision (`sandbox` until real KYB vendors are wired).
  provider    String    @default("sandbox")
  providerRef String?
  /// PII payload — encrypted at rest in production.
  fields      Json
  /// 32-byte commitment (hex) mirrored on-chain as `data_hash`.
  dataHash    String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([businessId])
  @@index([status])
}

/// Mirror of the on-chain Passport for fast reads/dashboards. Never authoritative.
model PassportProjection {
  business     Business  @relation(fields: [businessId], references: [id])
  businessId   String    @id
  kybStatus    KybStatus
  score        Int
  riskBand     RiskBand
  loansTotal   Int       @default(0)
  loansRepaid  Int       @default(0)
  onTimeStreak Int       @default(0)
  issuedAt     DateTime
  updatedAt    DateTime
  dataHash     String
}

model Opportunity {
  id          String            @id @default(cuid())
  businessId  String
  business    Business          @relation(fields: [businessId], references: [id])
  title       String
  description String            @default("")
  /// USDC stroops as string to preserve precision.
  amount      String
  funded      String            @default("0")
  termDays    Int
  aprBps      Int
  riskBand    RiskBand
  status      OpportunityStatus @default(Draft)
  /// On-chain escrow opportunity id (u64) once created on-chain.
  onchainId   String?
  createdAt   DateTime          @default(now())

  fundings   Funding[]
  repayments Repayment[]

  @@index([businessId])
  @@index([status])
}

model Funding {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  investor      String
  amount        String
  txHash        String?
  createdAt     DateTime    @default(now())

  @@index([opportunityId])
  @@index([investor])
}

model Repayment {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  amount        String
  onTime        Boolean     @default(true)
  isFinal       Boolean     @default(false)
  txHash        String?
  createdAt     DateTime    @default(now())

  @@index([opportunityId])
}

/// Append-only log of on-chain reputation events, indexed from contract events.
model ScoreEvent {
  id          String   @id @default(cuid())
  business    String
  scoreBefore Int
  scoreAfter  Int
  reason      String
  txHash      String?
  createdAt   DateTime @default(now())

  @@index([business])
}

enum LedgerKind {
  Grant
  Deposit
  Fund
  Repay
  Payout
  Collateral
  CollateralReturn
  Withdraw
}

/// Append-only USDC ledger backing the Testnet/mock balances: a wallet's
/// balance is the SUM of its entries. Real on-chain USDC replaces this once
/// funding providers (SEP-24 anchors) are integrated.
model LedgerEntry {
  id             String     @id @default(cuid())
  stellarAddress String
  kind           LedgerKind
  /// Signed USDC stroops (1 USDC = 10_000_000): credits > 0, debits < 0.
  amountStroops  BigInt
  provider       String?
  reference      String?
  /// Makes one-shot entries (e.g. the signup grant) safe to retry.
  idempotencyKey String?
  createdAt      DateTime   @default(now())

  @@unique([stellarAddress, idempotencyKey])
  @@index([stellarAddress])
}
