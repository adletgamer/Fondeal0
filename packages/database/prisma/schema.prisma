// Fondealo off-chain index + PII store.
//
// On-chain (Soroban) remains authoritative for anything trust-bearing
// (Passport, score). This database is a fast, queryable PROJECTION of on-chain
// state plus off-chain data that must never live on-chain (KYB PII, opportunity
// descriptions, UX metadata). Only `data_hash` commitments bridge the two.

generator client {
  provider      = "prisma-client-js"
  // Vercel runs on Amazon Linux (rhel-openssl-3.0.x); local dev is Windows/macOS.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled connection (pgbouncer) doesn't support the session-level
  // features Prisma Migrate needs; directUrl gives migrations a direct
  // connection while runtime queries keep using the pooled one.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum KybStatus {
  None
  Processing
  Accepted
  Rejected
}

enum UnderwritingStatus {
  Review
  Approved
  Declined
}

enum RiskBand {
  A
  B
  C
  D
  E
}

enum OpportunityStatus {
  Draft
  Open
  Funded
  Active
  Repaid
  Defaulted
  Cancelled
}

/// A wallet's chosen side of the marketplace. Set once during onboarding
/// (docs/product-v2.md role-selection flow) and enforced server-side —
/// a Business wallet can never load /invest and vice versa.
enum UserRole {
  Business
  Investor
}

/// A registered business. `stellarAddress` is the on-chain identity key.
model Business {
  id              String   @id @default(cuid())
  stellarAddress  String   @unique
  legalName       String
  country         String
  email           String?
  /// KYB profile captured at registration (docs/strategy/verifier-network.md).
  sector          String?
  taxId           String?
  foundedYear     Int?
  revenueBand     String?
  /// Off-chain look of the Passport (identity layer only — never credit data).
  passportTheme   String?
  passportAccent  String?
  passportPattern String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  kybSubmissions          KybSubmission[]
  evidenceReferences      EvidenceReference[]
  evidenceAcquisitions    EvidenceAcquisition[]
  providerChecks          ProviderCheck[]
  verificationAuditEvents VerificationAuditEvent[]
  underwritingDecisions   UnderwritingDecision[]
  kybDecisions            KybDecision[]
  opportunities           Opportunity[]
  passport                PassportProjection?

  @@unique([country, taxId])
  @@index([country])
}

/// A logged-in wallet. Identity is anchored to `privyUserId` (verified
/// server-side from the Privy session on every request — never trusted from
/// a client-supplied address); `stellarAddress` is the embedded Stellar
/// wallet Privy creates on first login. `role` is null until onboarding's
/// role-selection step persists it.
model UserWallet {
  id             String    @id @default(cuid())
  privyUserId    String?   @unique
  stellarAddress String    @unique
  role           UserRole?
  createdAt      DateTime  @default(now())
  lastLoginAt    DateTime?
}

/// KYB intake, shaped after SEP-12. `fields` holds provider-specific data (PII).
model KybSubmission {
  id                    String                 @id @default(cuid())
  businessId            String
  business              Business               @relation(fields: [businessId], references: [id])
  underwritingDecisions UnderwritingDecision[]
  kybDecisions          KybDecision[]
  status                KybStatus              @default(Processing)
  /// Which verifier issued the decision (`sandbox` until real KYB vendors are wired).
  provider              String                 @default("sandbox")
  providerRef           String?
  /// PII payload — encrypted at rest in production.
  fields                Json
  /// Client-generated retry token. Unique across submissions; ownership is checked before reuse.
  idempotencyKey        String?                @unique
  consentAt             DateTime?
  consentVersion        String?
  /// 32-byte commitment (hex) mirrored on-chain as `data_hash`.
  dataHash              String?
  reviewedAt            DateTime?
  createdAt             DateTime               @default(now())

  evidenceReferences   EvidenceReference[]
  evidenceAcquisitions EvidenceAcquisition[]
  providerChecks       ProviderCheck[]
  auditEvents          VerificationAuditEvent[]

  @@index([businessId])
  @@index([status])
}

/// A paid provider call and its settlement lifecycle, without retaining raw provider payloads.
model EvidenceAcquisition {
  id              String          @id @default(cuid())
  businessId      String
  business        Business        @relation(fields: [businessId], references: [id])
  kybSubmissionId String
  kybSubmission   KybSubmission   @relation(fields: [kybSubmissionId], references: [id])
  providerId      String
  evidenceType    String
  country         String
  requestHash     String
  idempotencyKey  String          @unique
  network         String
  asset           String
  quotedAmount    String?
  paidAmount      String?
  paymentStatus   String          @default("Pending")
  paymentTxHash   String?
  requestedAt     DateTime        @default(now())
  paidAt          DateTime?
  fulfilledAt     DateTime?
  responseHash    String?
  failureCode     String?
  retryable       Boolean         @default(false)
  createdAt       DateTime        @default(now())
  providerChecks  ProviderCheck[]

  @@index([businessId, createdAt])
  @@index([kybSubmissionId, createdAt])
  @@index([providerId, evidenceType, country])
}

/// Metadata only. No document bytes or public object URL are stored here.
model EvidenceReference {
  id               String          @id @default(cuid())
  businessId       String
  business         Business        @relation(fields: [businessId], references: [id])
  kybSubmissionId  String
  kybSubmission    KybSubmission   @relation(fields: [kybSubmissionId], references: [id])
  kind             String
  sourceType       String
  status           String          @default("Declared")
  /// Reserved for a future private storage adapter; never a public URL.
  privateObjectKey String?
  createdAt        DateTime        @default(now())
  expiresAt        DateTime?
  providerChecks   ProviderCheck[]

  @@unique([kybSubmissionId, kind, sourceType])
  @@index([businessId, createdAt])
}

/// One normalized provider result per idempotent check.
model ProviderCheck {
  id                    String               @id @default(cuid())
  businessId            String
  business              Business             @relation(fields: [businessId], references: [id])
  kybSubmissionId       String
  kybSubmission         KybSubmission        @relation(fields: [kybSubmissionId], references: [id])
  idempotencyKey        String               @unique
  providerId            String
  sourceType            String
  checkType             String
  result                String
  evidenceReferenceId   String?
  evidenceReference     EvidenceReference?   @relation(fields: [evidenceReferenceId], references: [id])
  evidenceAcquisitionId String?
  evidenceAcquisition   EvidenceAcquisition? @relation(fields: [evidenceAcquisitionId], references: [id], onDelete: SetNull)
  checkedAt             DateTime
  expiresAt             DateTime?
  reasonCodes           Json
  failureCode           String?
  retryable             Boolean              @default(false)
  createdAt             DateTime             @default(now())

  @@index([businessId, createdAt])
  @@index([kybSubmissionId])
  @@index([evidenceAcquisitionId])
}

/// Append-only application and sensitive-access audit trail. No raw PII.
model VerificationAuditEvent {
  id               String        @id @default(cuid())
  businessId       String
  business         Business      @relation(fields: [businessId], references: [id])
  kybSubmissionId  String
  kybSubmission    KybSubmission @relation(fields: [kybSubmissionId], references: [id])
  actorPrivyUserId String
  action           String
  metadata         Json
  createdAt        DateTime      @default(now())

  @@index([businessId, createdAt])
  @@index([kybSubmissionId, createdAt])
}

/// Immutable risk decisions. An approval is tied to one real KYB submission,
/// evidence and a policy version; a newer decision supersedes it for new loans.
model UnderwritingDecision {
  id                  String             @id @default(cuid())
  businessId          String
  business            Business           @relation(fields: [businessId], references: [id])
  kybSubmissionId     String
  kybSubmission       KybSubmission      @relation(fields: [kybSubmissionId], references: [id])
  status              UnderwritingStatus
  policyVersion       String
  reasonCodes         Json
  evidenceRefs        Json
  decidedBy           String?
  maxPrincipalStroops BigInt?
  maxTermDays         Int?
  expiresAt           DateTime?
  createdAt           DateTime           @default(now())

  @@index([businessId, createdAt])
  @@index([kybSubmissionId])
}

/// Mirror of the on-chain Passport for fast reads/dashboards. Never authoritative.
model PassportProjection {
  business     Business  @relation(fields: [businessId], references: [id])
  businessId   String    @id
  kybStatus    KybStatus
  score        Int
  riskBand     RiskBand
  loansTotal   Int       @default(0)
  loansRepaid  Int       @default(0)
  onTimeStreak Int       @default(0)
  issuedAt     DateTime
  updatedAt    DateTime
  dataHash     String
}

model Opportunity {
  id          String            @id @default(cuid())
  businessId  String
  business    Business          @relation(fields: [businessId], references: [id])
  title       String
  description String            @default("")
  /// USDC stroops as string to preserve precision.
  amount      String
  funded      String            @default("0")
  termDays    Int
  aprBps      Int
  riskBand    RiskBand
  status      OpportunityStatus @default(Draft)
  /// On-chain escrow opportunity id (u64) once created on-chain.
  onchainId   String?
  createdAt   DateTime          @default(now())

  fundings   Funding[]
  repayments Repayment[]

  @@index([businessId])
  @@index([status])
}

model Funding {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  investor      String
  amount        String
  txHash        String?
  createdAt     DateTime    @default(now())

  @@index([opportunityId])
  @@index([investor])
}

model Repayment {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  amount        String
  onTime        Boolean     @default(true)
  isFinal       Boolean     @default(false)
  txHash        String?
  createdAt     DateTime    @default(now())

  @@index([opportunityId])
}

/// Append-only log of on-chain reputation events, indexed from contract events.
model ScoreEvent {
  id          String   @id @default(cuid())
  business    String
  scoreBefore Int
  scoreAfter  Int
  reason      String
  txHash      String?
  createdAt   DateTime @default(now())

  @@index([business])
}

enum LedgerKind {
  Grant
  Deposit
  Fund
  Repay
  Payout
  Collateral
  CollateralReturn
  Withdraw
}

/// Append-only USDC ledger backing the Testnet/mock balances: a wallet's
/// balance is the SUM of its entries. Real on-chain USDC replaces this once
/// funding providers (SEP-24 anchors) are integrated.
model LedgerEntry {
  id             String     @id @default(cuid())
  stellarAddress String
  kind           LedgerKind
  /// Signed USDC stroops (1 USDC = 10_000_000): credits > 0, debits < 0.
  amountStroops  BigInt
  provider       String?
  reference      String?
  /// Makes one-shot entries (e.g. the signup grant) safe to retry.
  idempotencyKey String?
  createdAt      DateTime   @default(now())

  @@unique([stellarAddress, idempotencyKey])
  @@index([stellarAddress])
}

/// Who joined the early-access list (docs/strategy/2026-10-20-landing-refactor-plan.md §7).
enum WaitlistProfile {
  StartupPreSeed
  StartupRevenue
  Mype
  Funder
  Other
}

/// Where the company is incorporated — decides whether today's registry rules fit it.
enum WaitlistCountry {
  Peru
  UnitedStates
  OtherCountry
  NotIncorporated
}

/// Early-access waitlist. Deliberately separate from Business/UserWallet:
/// joining creates no account, wallet or KYB record, and stores only the
/// minimum personal data (Ley 29733). Rows are never overwritten by a later
/// submission, because anyone can type any email address.
model WaitlistEntry {
  id             String          @id @default(cuid())
  /// Trimmed and lower-cased; one row per address.
  email          String          @unique
  profile        WaitlistProfile
  country        WaitlistCountry
  companyName    String?
  interviewOptIn Boolean         @default(false)
  consentVersion String
  consentAt      DateTime
  /// HMAC of the client IP (never the raw IP), used only for rate limiting.
  /// Null when WAITLIST_IP_SECRET is not configured.
  ipHash         String?
  unsubscribedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([ipHash, createdAt])
  @@index([profile])
}

/// Back-office roles. A person may hold several (docs/adr/0011-admin-back-office-and-decision-authority.md).
enum StaffRole {
  Reviewer
  Approver
  Admin
}

enum StaffStatus {
  Active
  Suspended
  Revoked
}

/// Privy authenticates; this table authorizes. A verified Privy session gets
/// no back-office access unless it maps to an Active row here.
model StaffMember {
  id          String      @id @default(cuid())
  /// The Privy user id from the verified access token (`sub`), never an email.
  privyUserId String      @unique
  /// For display and notices only. Never used to authorize.
  email       String
  roles       StaffRole[]
  status      StaffStatus @default(Active)
  /// Decisions require a second factor verified by Fondealo itself (step-up).
  mfaRequired Boolean     @default(true)
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  decisionsMade     KybDecision[] @relation("KybDecisionActor")
  decisionsPrepared KybDecision[] @relation("KybDecisionPreparer")

  @@index([status])
}

enum KybDecisionKind {
  Claim
  RequestInformation
  Approve
  Reject
  Reopen
}

enum KybCaseStatus {
  Received
  InReview
  NeedsInformation
  Approved
  Rejected
  ReviewDue
}

/// One row per decision on a KYB case. Append-only: a database trigger rejects
/// UPDATE and DELETE. The case state is derived from the latest row, and
/// `KybSubmission.status` is only its projection.
model KybDecision {
  id                   String          @id @default(cuid())
  businessId           String
  business             Business        @relation(fields: [businessId], references: [id])
  kybSubmissionId      String
  kybSubmission        KybSubmission   @relation(fields: [kybSubmissionId], references: [id])
  kind                 KybDecisionKind
  fromStatus           KybCaseStatus
  toStatus             KybCaseStatus
  actorStaffId         String
  actor                StaffMember     @relation("KybDecisionActor", fields: [actorStaffId], references: [id])
  preparedByStaffId    String?
  preparedBy           StaffMember?    @relation("KybDecisionPreparer", fields: [preparedByStaffId], references: [id], onDelete: Restrict)
  /// `enforced` or `solo` (one operator, Testnet only).
  separationMode       String
  /// The policy the decision was made under, e.g. `kyb-v1-draft`.
  policyVersion        String
  reasonCodes          Json
  /// Checklist answers with their sources and notes (approvals only).
  checklist            Json
  /// Hash of what the reviewer saw; evidence may change later, this does not.
  evidenceSnapshotHash String
  /// Approvals only: the KYB credential `data_hash` published on-chain.
  credentialCommitment String?
  /// Approvals only: the salt behind `credentialCommitment`. Never leaves the server.
  commitmentSalt       String?
  idempotencyKey       String          @unique
  decidedAt            DateTime        @default(now())
  expiresAt            DateTime?

  @@index([kybSubmissionId, decidedAt])
  @@index([businessId, decidedAt])
}

/// Append-only record of staff access changes and sensitive reads (bootstrap,
/// role changes, suspensions, full tax-number reveals). No raw PII.
model StaffAuditEvent {
  id            String   @id @default(cuid())
  actorStaffId  String?
  action        String
  targetStaffId String?
  metadata      Json
  createdAt     DateTime @default(now())

  @@index([actorStaffId, createdAt])
  @@index([targetStaffId, createdAt])
}
